# 릴리스 서명 설정 템플릿.
#   cp keystore.properties.example keystore.properties  후 값을 채운다.
#   keystore.properties 와 .jks 파일은 .gitignore 로 커밋이 막혀 있다.
#
# storeFile 은 절대경로 권장(상대경로는 android/ 디렉터리 기준).
# 키스토어 생성 방법은 RELEASE.md "3. 업로드 키스토어 생성" 참고.
storeFile=/home/사용자명/zami-upload-key.jks
storePassword=CHANGE_ME
keyAlias=zami-upload
keyPassword=CHANGE_ME
